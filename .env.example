# Netlify/Vercel/Server environment variables
# 1) Create a Google Cloud project
# 2) Enable Places API
# 3) Create an API key
# 4) Get your Place ID

GOOGLE_PLACES_API_KEY=

# Option A (recommended): set a Place ID directly (format: "ChIJ...")
GOOGLE_PLACE_ID=

# Option B: skip Place ID and let the server resolve it
# Example query: Red Lantern Restaurant Colva Goa
GOOGLE_PLACE_QUERY=

# Optional but improves accuracy when resolving from query:
# Use "lat,lng" (no spaces). Example from your share link: 15.2687923,73.9287667
GOOGLE_LOCATION_BIAS=

# OpenAI API key for the Admin > Growth Ideas AI Trend Scanner.
# Keep this in a local .env file or hosting environment, never in Git.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.
OPENAI_GROWTH_MODEL=gpt-5
