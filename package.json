{
  "name": "red-lantern-website",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "minify:css": "cleancss -o style.min.css style.css",
    "check": "node --check server.js && node --check admin-cms.js && node --check air-menu.js && node --check captain.js && node --check captain-sw.js && node --check orders.js && node --check print-bridge.js && node --check orders-sw.js",
    "bundle:print-bridge": "bash scripts/build-print-bridge-bundles.sh",
    "package:bridge:macos": "bash scripts/package-print-bridge-macos.sh",
    "package:bridge:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-print-bridge-windows.ps1",
    "build": "npm run check && npm run minify:css && npm run bundle:print-bridge",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env server.js",
    "print-bridge": "node print-bridge.js",
    "test": "npm run build && node scripts/test-print-bridge.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grezello94/red-lantern-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/grezello94/red-lantern-website/issues"
  },
  "homepage": "https://github.com/grezello94/red-lantern-website#readme",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@neondatabase/serverless": "^0.10.4",
    "@tesseract.js-data/eng": "^1.0.0",
    "cloudinary": "^2.5.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pdfjs-dist": "^5.4.149",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.1",
    "tesseract.js": "^6.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3"
  }
}
